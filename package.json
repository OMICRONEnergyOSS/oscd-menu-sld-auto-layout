{
  "name": "@omicronenergy/oscd-menu-coord-tools",
  "description": "OpenSCD menu plugins for SLD coordinate positioning, copying, and cleanup",
  "license": "Apache-2.0",
  "author": "OMICRON electronics GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-menu-coord-tools.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-menu-coord-tools/issues"
  },
  "homepage": "https://omicronenergyoss.github.io/oscd-menu-coord-tools/demo/",
  "keywords": [
    "OpenSCD",
    "IEC61850",
    "SCL",
    "SLD"
  ],
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/__snapshots__/**",
    "!dist/demo/**",
    "!dist/assets/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/oscd-menu-sld-positioner.d.ts",
      "default": "./dist/oscd-menu-sld-positioner.js"
    },
    "./oscd-menu-sld-positioner.js": {
      "types": "./dist/oscd-menu-sld-positioner.d.ts",
      "default": "./dist/oscd-menu-sld-positioner.js"
    }
  },
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "compile": "oscd build",
    "build": "oscd build",
    "bundle": "oscd bundle",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "start": "oscd start",
    "start:bundle": "oscd start-bundle",
    "updates": "oscd updates",
    "deploy": "oscd bundle && oscd deploy",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@omicronenergy/oscd-editor-sld": "^1.0.0",
    "@omicronenergy/oscd-editor-source": "^0.0.5",
    "@omicronenergy/oscd-menu-commons": "^0.0.2",
    "@omicronenergy/oscd-shell": "^0.0.18",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.1",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@omicronenergy/oscd-tooling": "^0.0.6",
    "@open-wc/testing": "^5.0.0",
    "@openscd/oscd-editor": "^1.8.0",
    "lit": "^3.3.3"
  }
}
